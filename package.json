{
  "name": "mullion-terminal",
  "version": "0.1.4",
  "description": "A standalone terminal with Mullion's familiar look, local command learning and a directory sidebar.",
  "author": {
    "name": "Abdelrahman Nabil",
    "email": "a.nabiil@hotmail.com"
  },
  "homepage": "https://github.com/anabiiil/mullion-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/anabiiil/mullion-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/anabiiil/mullion-terminal/issues"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs && node --import tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "install-electron --no && electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "playwright": "^1.55.0"
  },
  "build": {
    "appId": "dev.mullion.terminal",
    "productName": "Mullion Terminal",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Mullion-Terminal-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "mullion-terminal",
      "synopsis": "A standalone terminal with local command learning and a directory sidebar.",
      "description": "Mullion Terminal is a standalone desktop terminal with Mullion's familiar look, local command learning and a directory sidebar.",
      "maintainer": "Abdelrahman Nabil <a.nabiil@hotmail.com>"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "Mullion-LICENSE.txt"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ]
  }
}
